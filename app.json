{
  "expo": {
    "name": "Dot Claim",
    "slug": "dot-claim",
    "version": "1.2.0",
    "description": "Renkli noktaları bağla, üçgen alanları sahiplen ve rakibinden yüksek puan al.",
    "scheme": "dotclaim",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.dotclaim",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.dotclaim",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#07111F"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07111F",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil avatarını seçebilmek için fotoğraf arşivine erişim gerekir."
        }
      ],
      "expo-secure-store"
    ]
  }
}
