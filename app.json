{
  "expo": {
    "name": "Dot Claim",
    "slug": "dot-claim",
    "version": "1.2.0",
    "description": "Renkli noktaları bağla, üçgen alanları sahiplen ve rakibinden yüksek puan al.",
    "scheme": "dotclaim",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07111F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.dotclaim",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.dotclaim",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#07111F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-audio"
    ]
  }
}
