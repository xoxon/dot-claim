{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_MATCH_SERVER_URL": "https://match.barkodgenerator.com",
        "EXPO_PUBLIC_ADMOB_USE_TEST_ADS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_MATCH_SERVER_URL": "https://match.barkodgenerator.com",
        "EXPO_PUBLIC_ADMOB_USE_TEST_ADS": "true"
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_MATCH_SERVER_URL": "https://match.barkodgenerator.com",
        "EXPO_PUBLIC_ADMOB_USE_TEST_ADS": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6808729303"
      }
    }
  }
}
