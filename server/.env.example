# Public HTTPS address served by CloudPanel / Nginx.
PUBLIC_BASE_URL=https://match.barkodgenerator.com

# Keep the game server private; CloudPanel proxies this port.
PORT=3001
ALLOWED_ORIGINS=*

# Optional: defaults are server/data and server/uploads/avatars.
# DATABASE_PATH=/absolute/path/outside/the/git/repository/dot-claim.sqlite
# AVATAR_DIRECTORY=/absolute/path/outside/the/git/repository/avatars
MAX_AVATAR_BYTES=900000

# Optional. Required only if Expo Push Security is enabled in the Expo dashboard.
# EXPO_PUSH_ACCESS_TOKEN=your-expo-access-token
